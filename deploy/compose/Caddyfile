# Caddy is the only service with published ports, and it serves HTTPS for
# M4P_DOMAIN: a real domain gets a certificate from Let's Encrypt, and
# "localhost" gets one from Caddy's own local certificate authority.
{$M4P_DOMAIN} {
	encode zstd gzip

	# Large files go straight to object storage with presigned URLs, so API
	# requests never need big bodies, except workers writing through the
	# storage proxy (one object, such as an image shard, per request).
	@storage path_regexp ^/api/worker/v1/jobs/[^/]+/storage/
	@api {
		path /api/*
		not path_regexp ^/api/worker/v1/jobs/[^/]+/storage/
	}
	request_body @api {
		max_size 8MiB
	}
	request_body @storage {
		max_size 4GiB
	}

	# Browsers upload file parts straight to object storage, with URLs the
	# API presigns for one part each. Only those requests reach SeaweedFS:
	# a PUT of one part, into the project area of the ml4paleo bucket, with a
	# signature. SeaweedFS checks the signature (which covers the exact
	# length) itself.
	@upload_part {
		method PUT
		path /ml4paleo/projects/*
		query uploadId=* partNumber=* X-Amz-Signature=*
	}
	handle @upload_part {
		request_body {
			max_size 1GiB
		}
		reverse_proxy seaweedfs:8333
	}

	handle {
		reverse_proxy api:8000
	}
}

# Workers on this machine reach the worker API here, over the jobs network.
# This port is not published, and it serves nothing but the worker API.
http://:8080 {
	@storage path_regexp ^/api/worker/v1/jobs/[^/]+/storage/
	@messages {
		path /api/worker/*
		not path_regexp ^/api/worker/v1/jobs/[^/]+/storage/
	}
	request_body @messages {
		max_size 8MiB
	}
	request_body @storage {
		max_size 4GiB
	}
	@worker path /api/worker/*
	handle @worker {
		reverse_proxy api:8000
	}
	respond 404
}
